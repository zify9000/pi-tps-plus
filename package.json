{
  "name": "pi-tps-plus",
  "version": "0.1.0",
  "description": "Tokens-per-second, per-turn tool wall time, and a per-loop summary for pi — fork of @monotykamary/pi-tps",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "tps",
    "telemetry",
    "profiling"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "CHANGELOG.md",
    "extensions"
  ],
  "scripts": {
    "check": "node dev/check.mjs",
    "render": "node dev/render-real.mjs",
    "demo:highlight": "node dev/demo-highlight.mjs",
    "install:local": "node dev/install-local.mjs",
    "uninstall:local": "node dev/install-local.mjs --uninstall",
    "typecheck": "node dev/make-tsconfig.mjs && tsc -p .check/tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
